APP_ENV=development
APP_DEBUG=false
# Web server-only setting (set before build and runtime if changing default):
# API_ORIGIN=http://127.0.0.1:8002
# Generate a local password; never commit .env
POSTGRES_PASSWORD=
DEV_DB_PORT=5433
TEST_DB_PORT=5434

# API-local apps/api/.env (substitute local password; do not commit):
# DATABASE_URL=postgresql+psycopg://devtreck:YOUR_LOCAL_PASSWORD@127.0.0.1:5433/devtreck
# apps/api/.env.test or CI environment, disposable tests only:
# TEST_DATABASE_URL=postgresql+psycopg://devtreck:YOUR_LOCAL_PASSWORD@127.0.0.1:5434/devtreck_test
